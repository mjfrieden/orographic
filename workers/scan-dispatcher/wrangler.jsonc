{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orographic-scan-dispatcher",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "mjfrieden",
    "GITHUB_REPO": "orographic",
    "GITHUB_WORKFLOW": "orographic_scan.yml",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": [
      "7 14,17,20 * * 1-5"
    ]
  }
}
