{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orographic-scan-dispatcher",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "mjfrieden",
    "GITHUB_REPO": "orographic",
    "GITHUB_WORKFLOW": "orographic_scan.yml",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": [
      // The paired UTC hours cover both Chicago offsets; the Worker dispatches
      // only at 09:07, 12:07, and 15:07 America/Chicago on weekdays.
      "7 14,15,17,18,20,21 * * MON-FRI"
    ]
  }
}
