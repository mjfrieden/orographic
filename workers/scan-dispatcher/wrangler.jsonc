{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orographic-scan-dispatcher",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "mjfrieden",
    "GITHUB_REPO": "orographic",
    "GITHUB_WORKFLOW": "orographic_scan.yml",
    "GITHUB_OUTCOME_WORKFLOW": "orographic_outcome_capture.yml",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": [
      // The broad UTC range covers both Chicago daylight and standard time.
      // The handler dispatches hourly captures at 09:15-15:15 Chicago and
      // full scans at 09:25, 12:25, and 15:25 Chicago. Keeping scans ten
      // minutes after capture avoids queueing both workflows on the shared
      // research-write concurrency group.
      "15,25 13-22 * * MON-FRI"
    ]
  }
}
