{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orographic-scan-dispatcher",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "mjfrieden",
    "GITHUB_REPO": "orographic",
    "GITHUB_WORKFLOW": "orographic_scan.yml",
    "GITHUB_OUTCOME_WORKFLOW": "orographic_outcome_capture.yml",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": [
      // The UTC range covers market hours in both Chicago offsets. The Worker
      // dispatches outcome capture every five minutes from 08:25 through 15:10
      // Chicago time and full scans at 09:07, 12:07, and 15:07.
      "*/5 13-22 * * MON-FRI",
      "7 14,15,17,18,20,21 * * MON-FRI"
    ]
  }
}
