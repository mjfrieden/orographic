{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orographic-scan-dispatcher",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "mjfrieden",
    "GITHUB_REPO": "orographic",
    "GITHUB_WORKFLOW": "orographic_scan.yml",
    "GITHUB_OUTCOME_WORKFLOW": "orographic_outcome_capture.yml",
    "GITHUB_REF": "main"
  },
  "triggers": {
    "crons": [
      "7 17,18 * * MON-FRI",
      // UTC range covers Chicago daylight and standard time. Capture every
      // ten minutes from 08:30 through 15:30; scans remain at 09/12/15:25.
      // Keep the shared writer lock to prevent lost operational ledger updates.
      "0,10,20,25,30,40,50 13-22 * * MON-FRI"
    ]
  }
}
